# Copie para .env e preencha (o .env NÃO vai pro git)
# cp .env.example .env   (ou copie manualmente no Windows)

# --- Banco (Postgres LOCAL na 5432 — sem Docker) ---
DB_URL=jdbc:postgresql://localhost:5432/minitask
DB_USERNAME=postgres
DB_PASSWORD=postgres

# local: false. Só true se for usar o compose.yaml (outro ambiente)
DOCKER_COMPOSE_ENABLED=false

# --- JWT ---
APP_JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio

# --- OTP e-mail (Brevo) ---
APP_OTP_BREVO_API_KEY=
APP_OTP_BREVO_SENDER_EMAIL=
APP_OTP_BREVO_SENDER_NAME=Mini Task

# --- OTP WhatsApp (Evolution) ---
# Servidor (sempre no env). Instância conectada fica no banco via ADMIN.
APP_OTP_EVOLUTION_BASE_URL=http://localhost:8081
APP_OTP_EVOLUTION_API_KEY=
# fallback se não houver instância active no banco:
APP_OTP_EVOLUTION_INSTANCE=

# --- Bot / CORS ---
APP_BOT_API_KEY=dev-bot-key
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
APP_FRONTEND_BASE_URL=http://localhost:5173

# --- n8n (webhook MESSAGES_UPSERT na Evolution ao criar instância) ---
# Preferência: URL completa do webhook
APP_N8N_WEBHOOK_URL=
# Ou só a base do n8n (monta .../webhook/minitask-whatsapp)
APP_N8N_BASE_URL=
